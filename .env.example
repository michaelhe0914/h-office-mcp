# 金安出版社 h-office 系統登入憑證設定
# 請複製此檔案為 .env 並填入您的登入帳號與密碼

H_OFFICE_EMAIL=your_email@gmail.com
H_OFFICE_PASSWORD=your_password

# 可選：系統網址（預設為 https://h-office.king-an.com.tw:8082）
# H_OFFICE_BASE_URL=https://h-office.king-an.com.tw:8082

# 可選：登入時是否無頭模式執行（預設為 false，開啟瀏覽器視窗以支援雙重驗證）
# H_OFFICE_HEADLESS=false
